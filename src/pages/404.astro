---
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = posts[0];
const earlier = posts.slice(1, 4);

// Every line is padded to W by row(), so a long post title truncates instead of
// pushing the right rail out of alignment.
const W = 52;
const row = (s = "") => `│${s.padEnd(W).slice(0, W)}│`;
const rail = (l: string, m: string, r: string) => l + m.repeat(W) + r;
const fit = (s: string, indent: number) =>
  s.length > W - indent - 2 ? s.slice(0, W - indent - 3) + "…" : s;

function formatDate(date: Date): string {
  return date
    .toLocaleDateString("en-US", { month: "long", year: "numeric" })
    .toLowerCase();
}

const navLeft = " mltru";
const navRight = "posts    about  ";
const nav = navLeft + " ".repeat(W - navLeft.length - navRight.length) + navRight;

// Fixed ragged pattern rather than random, so the drawing is identical between
// builds and never shows up as diff noise.
const paragraph = [
  "▓▓▓▓▓▓▓▓▓▓▓▓▓▓ ▓▓▓▓▓▓▓ ▓▓▓▓▓▓▓▓▓▓▓ ▓▓▓▓▓▓",
  "▓▓▓▓▓▓▓ ▓▓▓▓▓▓▓▓▓▓▓▓ ▓▓▓▓ ▓▓▓▓▓▓▓▓▓▓▓▓▓▓",
  "▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ ▓▓▓▓▓▓▓▓ ▓▓▓",
];

const page = [
  rail("┌", "─", "┐"),
  row(nav),
  rail("├", "─", "┤"),
  row(),
  row("   ╭───╮"),
  row("  ( o o )   mircea"),
  row("   ╰─┬─╯    still taking things apart"),
  row(),
  row(" " + "·".repeat(W - 2) + " "),
  row(),
  ...(latest
    ? [
        row("  " + fit(latest.data.title.toLowerCase(), 2)),
        row("  " + formatDate(latest.data.date)),
        row(),
      ]
    : []),
  ...paragraph.map((line) => row("  " + line)),
  row(),
  row("  earlier"),
  ...earlier.map((post) => row("   · " + fit(post.data.title.toLowerCase(), 5))),
  row(),
  rail("└", "─", "┘"),
  "",
  "404 — this is a drawing of the page you wanted.",
  "it isn't the page. nothing here is clickable.",
].join("\n");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — mltru</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <p class="sr-only">
      404 — that page doesn't exist. Head to the homepage or the posts index.
    </p>
    <pre aria-hidden="true">{page}</pre>
  </body>
</html>

<style is:global>
  html {
    background: #2b2b2b;
  }

  body {
    margin: 0;
    padding: 1rem;
    background: #2b2b2b;
    color: #888;
  }

  pre {
    margin: 0;
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace;
    /* Holds the 54-char frame inside a 375px viewport without scrolling. */
    font-size: clamp(0.5rem, 2.4vw, 0.85rem);
    line-height: 1.15;
    overflow-x: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
