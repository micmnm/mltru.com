---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sk } from "../lib/sticker";
---

<BaseLayout title="404">
  <section class="gone">
    <!-- the spot on the mat where the sticker used to be -->
    <div class="outline" aria-hidden="true"></div>
    <div class="tile peeled" style={sk("404", { rot: 5, die: 7, radius: 16, mis: 1, scuff: 1, peel: 1 })}>
      <div class="st">
        <h1>404</h1>
        <p>the sticker you wanted peeled off.<br />all that's left is the outline.</p>
      </div>
    </div>
    <p class="back">
      <a href="/" class="btn st hop label" style={sk("404-home", { rot: -2, die: 4.5, radius: 40, mis: 0.8 })}>&larr; home</a>
      <a href="/posts" class="btn mint st hop label" style={sk("404-posts", { rot: 1.5, die: 4.5, radius: 40, mis: 0.8 })}>posts</a>
    </p>
  </section>
</BaseLayout>

<style>
  .gone { position: relative; margin: 1rem 0 1rem; min-height: 20rem; }
  .outline { position: absolute; inset: 1.5rem 0 4rem 1.2rem; border: 3px dashed rgba(255, 247, 224, .55); background: rgba(255, 255, 255, .06); border-radius: 26px 34px 22px 38px / 32px 24px 36px 26px; transform: rotate(-1.5deg); }
  .peeled { --c: var(--sunflower); position: relative; width: min(100%, 21rem); margin: 2.2rem 0 0 auto; }
  .peeled:hover { --lift: 3px; transform: rotate(var(--rot, 0deg)); }
  .peeled:hover::after { width: var(--peel); height: var(--peel); }
  .peeled .st { transform: none; padding: 1.6rem 1.6rem 1.8rem; }
  .peeled h1 { font-size: calc(clamp(3rem, 16vw, 4.5rem) * var(--ts)); line-height: 1; margin-bottom: .6rem; }
  .peeled p { font-size: 1.05rem; line-height: 1.5; font-weight: 700; font-variation-settings: "FLAR" 60; }
  .back { position: relative; display: flex; gap: 1.6rem; margin: 2rem 0 0 .6rem; }
</style>
