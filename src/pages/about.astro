---
import BaseLayout from "../layouts/BaseLayout.astro";
import { card } from "../lib/sticker";
---

<BaseLayout title="About">
  <article class="card about" style={card("about")}>
    <div class="card-face">
      <h1>About me</h1>
      <div class="prose">
        <p>
          My name is Mircea and I'm a computer hobbyist.
          I like to play on my computer by experimenting with software, tinkering and playing.
        </p>
        <p>
          <a href="https://mltru.com/">mltru.com</a> was created to keep track of my discoveries.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .about { margin-top: 1.2rem; }
  .about h1 { font-size: calc(clamp(1.7rem, 7vw, 2.6rem) * var(--ts)); margin-bottom: 1rem; }
</style>
