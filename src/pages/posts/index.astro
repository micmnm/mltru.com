---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sk } from "../../lib/sticker";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestPost = posts[0];
const olderPosts = posts.slice(1);

const olderByYear: Record<number, typeof posts> = {};
for (const post of olderPosts) {
  const year = post.data.date.getFullYear();
  if (!olderByYear[year]) olderByYear[year] = [];
  olderByYear[year].push(post);
}
const years = Object.keys(olderByYear).map(Number).sort((a, b) => b - a);

function stripMarkdown(body: string): string {
  return body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\(.*?\)/g, "$1")
    .replace(/[#*>`_~]/g, "")
    .trim();
}

function getExcerpt(body: string): string {
  const plain = stripMarkdown(body);
  const match = plain.match(/[^.!?]*[.!?]/);
  return match ? match[0].trim() : plain.slice(0, 120);
}

function getLongExcerpt(body: string): string {
  const plain = stripMarkdown(body);
  const sentences = plain.match(/[^.!?]+[.!?]+/g) || [];
  return sentences.slice(0, 3).join(" ").trim() || plain.slice(0, 300);
}
---

<BaseLayout title="Posts">
  <h1 class="page-title st" style={sk("posts-title", { rot: -2, die: 5, radius: 16, mis: 1 })}>Posts</h1>

  {latestPost && (
    <section class="latest">
      <div class="tile" style={sk(latestPost.id, { rot: -0.8, radius: 12, mis: 0.8, scuff: 1, peel: 1 })}>
        <a href={`/posts/${latestPost.id}/`} class="st latest-link">
          <span class="dir">latest</span>
          <h2 class="latest-title">{latestPost.data.title}</h2>
          <p class="latest-excerpt">{getLongExcerpt(latestPost.body ?? "")}</p>
          <span class="latest-read label">continue reading &rarr;</span>
        </a>
      </div>
    </section>
  )}

  {years.map((year) => (
    <section class="year-group">
      <h2 class="section-label st label" style={sk("year:" + year, { rot: -2, die: 3.5, radius: 40, mis: 1 })}>{year}</h2>
      <ul class="tiles">
        {olderByYear[year]?.map((post, i) => (
          <li class="tile" style={sk(post.id, { rot: [-1.4, 1.1, -0.7, 1.6][i % 4], radius: 10, mis: 0.55, scuff: 0.3, peel: 0.35 })}>
            <a href={`/posts/${post.id}/`} class="st">
              <span class="post-title">{post.data.title}</span>
              <span class="post-excerpt">{getExcerpt(post.body ?? "")}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .page-title { display: inline-block; --c: var(--sunflower); font-size: calc(2rem * var(--ts)); padding: .35rem 1.2rem .3rem; margin: 1rem 0 1.8rem .6rem; }
  .latest { margin: 0 0 3rem; }
  .latest .tile { --c: var(--mint); }
  .latest-title { font-size: calc(1.5rem * var(--ts)); margin: .1rem 0 .6rem; }
  .latest-excerpt { font-size: 1rem; line-height: 1.55; margin-bottom: .8rem; }
  .latest-read { display: inline-block; font-size: .9rem; }
  .year-group { margin-bottom: 2.6rem; }
  .year-group .section-label { margin-top: 0; }
</style>
