---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bobblehead from "../components/Bobblehead.astro";
import { sk, card } from "../lib/sticker";
import { getCollection, render } from "astro:content";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestPost = posts[0];
const olderPosts = posts.slice(1, 5);

const { Content } = latestPost ? await render(latestPost) : { Content: null };

// speech bubble outline, tail on the left toward the toy
const BL = "M40 6 H240 Q258 6 258 24 V40 Q258 58 240 58 H40 Q22 58 22 44 L3 55 L22 26 Q22 6 40 6Z";

function stripMarkdown(body: string): string {
  return body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\(.*?\)/g, "$1")
    .replace(/[#*>`_~]/g, "")
    .trim();
}

function getExcerpt(body: string): string {
  const plain = stripMarkdown(body);
  // Terminator must be followed by a space or end-of-text, so domains like
  // "mltru.com" don't get read as the end of the sentence.
  const match = plain.match(/^[\s\S]*?[.!?](?=\s|$)/);
  return match ? match[0].trim() : plain.slice(0, 120);
}

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
}
---

<BaseLayout home>
  <header class="intro lap">
    <Bobblehead size="hero" />
    <div class="intro-text">
      <h1 data-t="mircea">mircea</h1>
      <p class="bubble"><svg class="bb bb-l" viewBox="0 0 260 64" aria-hidden="true"><path class="bh" d={BL} /><path class="bf" d={BL} /><path class="bg" d={BL} /><path class="bi" d={BL} /></svg><span>still taking things apart</span></p>
    </div>
  </header>


  {latestPost && Content && (
    <article class="card" style={card(latestPost.id)}><div class="card-face">
      <h2 class="latest-title"><a href={`/posts/${latestPost.id}/`} class="latest-title-link">{latestPost.data.title}</a></h2>
      <time class="pill-date st label" style={sk("date:" + latestPost.id, { rot: -2, die: 4, radius: 40, mis: 0.7 })} datetime={latestPost.data.date.toISOString()}>{formatDate(latestPost.data.date)}</time>
      <div class="prose">
        <Content />
      </div>
    </div></article>
  )}

  {olderPosts.length > 0 && (
    <section class="older">
      <h3 class="section-label st label" style={sk("earlier", { rot: -2, die: 3.5, radius: 40, mis: 1 })}>earlier</h3>
      <ul class="tiles">
        {olderPosts.map((post, i) => (
          <li class="tile" style={sk(post.id, { rot: [-1.4, 1.1, -0.7, 1.6][i % 4], radius: 10, mis: 0.55, scuff: 0.3, peel: 0.35 })}>
            <a href={`/posts/${post.id}/`} class="st">
              <span class="post-title">{post.data.title}</span>
              <span class="post-excerpt">{getExcerpt(post.body ?? "")}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>


<style>
/* ---- intro: bobblehead + name + bubble, one cluster stuck over the card's top edge (.lap) ---- */
.intro { display: flex; align-items: flex-start; justify-content: flex-start; gap: 1.2rem; margin-top: -2.9rem; padding: 0 0 0 .3rem; }
.intro :global(.toy) { z-index: 4; }
.intro-text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; padding: .6rem 0 0; z-index: 3; }
.intro h1 { position: relative; isolation: isolate; display: inline-block; font-family: var(--font-display); font-weight: 400; letter-spacing: var(--d-ls); font-variation-settings: normal; font-size: var(--d-size); line-height: var(--d-lh); color: var(--sunflower); -webkit-text-stroke: var(--st) var(--ink); paint-order: stroke fill; stroke-linejoin: round; margin: 0; transform: rotate(-2.5deg); filter: drop-shadow(4px 5px 0 rgba(7,24,19,.4)); }
.intro h1::before { content: attr(data-t); position: absolute; inset: 0; z-index: -1; -webkit-text-stroke: var(--halo) #fff; paint-order: stroke fill; color: #fff; stroke-linejoin: round; }
.bubble { position: relative; display: block; width: 260px; height: 64px; margin: 0; font-weight: 700; font-variation-settings: "FLAR" 60; font-size: 1.05rem; color: var(--ink); transform: rotate(1.5deg); filter: drop-shadow(4px 4px 0 rgba(7,24,19,.4)); }
.bubble .bb { position: absolute; inset: 0; width: 260px; height: 64px; overflow: visible; }
.bubble .bh { fill: #fff; stroke: #fff; stroke-width: 19px; stroke-linejoin: round; filter: url(#wob3); }
.bubble .bf { fill: var(--bubblegum); transform: translate(-.9px, .8px) scale(.985); transform-origin: 140px 32px; }
.bubble .bg { fill: url(#grain); }
.bubble .bi { fill: none; stroke: var(--ink); stroke-width: 2.5px; stroke-linejoin: round; }
.bubble span { position: absolute; left: 22px; width: 236px; top: 6px; height: 52px; line-height: 52px; text-align: center; }
.latest-title { font-size: calc(clamp(1.7rem, 5vw, 2.3rem) * var(--ts)); margin: 0 0 .6rem; }
.latest-title-link { background: linear-gradient(var(--sunflower), var(--sunflower)) 0 92% / 0 .3em no-repeat; transition: background-size .3s var(--pop); }
.latest-title-link:hover, .latest-title-link:focus-visible { background-size: 100% .3em; }
@media (max-width: 520px) {
  .intro { gap: .7rem; margin-top: -2.1rem; padding: 0; }
  .intro :global(.toy--hero) { width: 4.4rem; }
  .intro-text { gap: .3rem; padding-top: 2.3rem; }
  .intro h1 { --d-size: 2.3rem; --st: 5px; --halo: 13px; }
  /* same bubble, scaled down; negative margins give back the layout space the scale frees */
  .bubble { transform: rotate(1.5deg) scale(.7); transform-origin: 0 0; margin: 0 -78px -19px 0; }
}
</style>
